# ---- Provider credentials (server-only unless prefixed NEXT_PUBLIC_) ----
# Alchemy app key. Used server-side for RPC, bundler and (optionally) Gas Manager.
ALCHEMY_API_KEY=
# Alchemy Gas Manager policy id. Only needed when SPONSOR_BACKEND=alchemy.
ALCHEMY_GAS_POLICY_ID=

# ---- Sponsor backend ----
# "self"    -> sign UserOperations for the deployed IncineratorPaymaster (VerifyingPaymaster).
# "alchemy" -> forward validated requests to Alchemy Gas Manager.
# unset     -> sponsorship unavailable; the app still works with user-paid transactions.
SPONSOR_BACKEND=
# Hot signing key for the VerifyingPaymaster (SPONSOR_BACKEND=self). Bounded exposure:
# it can only authorise spend of the paymaster's EntryPoint deposit. NEVER a treasury key.
SPONSOR_SIGNER_PRIVATE_KEY=

# ---- Server secrets ----
# HMAC secret for wallet session tokens (SIWE). 32+ random bytes, hex or base64.
SERVER_SIGNING_SECRET=
# Bearer token for the internal admin surface (/admin and /api/admin/*).
ADMIN_TOKEN=

# ---- Optional persistence ----
# PostgreSQL connection string. When unset, an in-memory store is used (single instance only).
DATABASE_URL=

# ---- Optional wallet integrations ----
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- Network selection ----
# "testnet" (default) or "mainnet". Do not switch to mainnet before testnet verification.
NEXT_PUBLIC_INCINERATOR_NETWORK=testnet
